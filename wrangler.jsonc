// Publicación en Cloudflare Workers, solo con archivos estáticos (sin código de servidor).
// `npm run deploy` construye la web y sube `dist/`. Antes vivía en GitHub Pages (juarez20jc.github.io).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sananton",
  // Cuenta de Cloudflare de OPCOMP (la del jefe): ahí viven los proyectos demostrativos.
  "account_id": "37ec3b4f60f578a10633d49efd331978",
  "compatibility_date": "2026-10-01",
  // Subdominio de opcomppe.com, como dluxe.opcomppe.com.
  "routes": [{ "pattern": "sananton.opcomppe.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // Es una sola página de React: cualquier ruta desconocida vuelve al inicio.
    "not_found_handling": "single-page-application"
  }
}
